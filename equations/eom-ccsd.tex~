\section{Matrix Elements}

Define the following matrix elements to make things go easier.

\begin{equation}
  \tau_{ij}^{ab} = t_{ij}^{ab} + t_i^at_j^b
\end{equation}

\begin{equation}
  \tilde{\tau}_{ij}^{ab} = \frac{1}{2}t_{ij}^{ab} + t_i^at_j^b
\end{equation}

\subsection{One Particle}

\begin{equation}
  \overline{H}_1 = \sum_{pq} F_{pq} N\left[\hat{a}_p^\dagger\hat{a}_q\right]
\end{equation}

\begin{equation}
  F_{ij} = f_{ij} + \sum_a t_j^a f_{ia} + \sum_{ka}t_k^a \tei{ki}{aj} + \sum_{kab} \tilde{\tau}_{kj}^{ba}\tei{ki}{ba}
\end{equation}

\begin{equation}
  F_{ab} = f_{ab} - \sum_i t_i^a f_{ib} + \sum_{ic} t_i^c \tei{ia}{cb} - \sum_{ijc}\ttau_{ij}^{ca} \tei{ij}{cb}
\end{equation}

\begin{equation}
  F_{ia} = f_{ia} - \sum_{jb}t_j^b \tei{ij}{ab}
\end{equation}

\begin{multline}
  F_{ai} = f_{ai} + \sum_j t_j^a f_{ji} - \sum_b t_i^b f_{ab} + \sum_{jb} \left(t_{ij}^{ba} + t_i^b t_j^a\right) f_{jb} - \sum_{jb} t_j^b\tei{ja}{bi} + \sum_{jkb}\ttau_{kj}^{ba}\tei{jk}{bi}\\
  - \sum_{jbc}\ttau_{ji}^{bc} \tei{ja}{bc} + \sum_{jkbc} t_j^b\tau_{ik}^{ca}\tei{jk}{bc} + \frac{1}{2}\sum_{jkbc} t_i^bt_{jk}^{ac}\tei{jk}{bc} + \frac{1}{2}\sum_{jkbc}t_j^at_{ik}^{bc}\tei{jk}{bc}
\end{multline}

Note that $F_{ai}$ is the expression for the $T_1$ residual. At convergence of CCSD, this residual is zero.

\begin{equation}
  F_{ai} = 0
\end{equation}


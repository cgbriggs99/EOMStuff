
# PYTHONPATH must include directory above plugin directory.
#     Define either externally or here, then import plugin.
sys.path.insert(0, '.')
import general_dlpno

molecule {
O
H 1 R
H 1 R 2 A

R = .9
A = 104.5
}

set {
  basis sto-3g
}

set general_dlpno {
  print 1
  cc_method ccsd
}

E = energy('general-dlpno')

E_expected = energy("dlpno-ccsd")

assert(abs(E - E_expected) < 1e-6)
